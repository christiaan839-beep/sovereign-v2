#!/usr/bin/env bash
#
# Sovereign Matrix — pre-push gate
#
# This hook used to carry its own list of checks, which drifted from the
# list in .github/workflows/ci.yml: it ran a Suspense hook-trap scan CI
# never ran, skipped the registry-drift check CI blocked on, and treated
# migration drift as fatal where CI treated it as a warning.
#
# There is one list now, in scripts/verify.mjs. This hook runs the
# "quick" profile of it: everything except `next build` and `npm audit`,
# both of which CI owns and neither of which is worth the wall-clock on
# every push.
#
# Install (once per clone):
#   npm run hooks:install
#
# Bypass for an emergency push (then fix forward, don't dwell):
#   PRE_PUSH_SKIP=1 git push
#
# See the gate list and which profile each belongs to:
#   node scripts/verify.mjs --list

set -uo pipefail

if [[ "${PRE_PUSH_SKIP:-0}" == "1" ]]; then
  echo "pre-push: skipped via PRE_PUSH_SKIP=1"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! node scripts/verify.mjs --profile=quick; then
  echo
  echo "pre-push: blocked. Fix the failing gate(s) above, or push with"
  echo "PRE_PUSH_SKIP=1 to bypass."
  exit 1
fi

exit 0
