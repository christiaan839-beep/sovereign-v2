{
  "version": "0.0.1",
  "_comment": "Launch targets resolve executables from PATH so this file works on any machine. It previously pinned an absolute nvm path and a macOS Python.framework path, which meant it only ran on one laptop — and this file ships in the Skills Pack.",
  "configurations": [
    {
      "name": "nextjs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "websocket-voice",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "ws"],
      "port": 8080
    },
    {
      "name": "ghost-protocol",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["nemo_ghost.py"],
      "port": 8001
    },
    {
      "name": "nemoclaw-daemon",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["server/python-agents/nemoclaw_os.py"],
      "port": 9090
    },
    {
      "name": "n8n-workflows",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "n8n"],
      "port": 5678,
      "autoPort": true
    }
  ]
}
