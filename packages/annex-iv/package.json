{
  "name": "@sovereign-matrix/annex-iv",
  "version": "0.1.0",
  "description": "EU AI Act Annex IV technical-documentation exporter. Takes a set of VAOS receipts and emits the Article 11 report as Markdown and JSON, naming a gap where the receipts do not support a section rather than filling it in.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "eu-ai-act",
    "annex-iv",
    "article-11",
    "high-risk-ai",
    "technical-documentation",
    "post-market-monitoring",
    "regulatory-compliance",
    "vaos",
    "verifiable-receipts",
    "ai-audit",
    "ai-governance",
    "compliance-as-code",
    "sovereign-matrix"
  ],
  "author": "Sovereign Matrix",
  "license": "Apache-2.0",
  "homepage": "https://github.com/christiaan839-beep/sovereign-v2/tree/main/packages/annex-iv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christiaan839-beep/sovereign-v2.git",
    "directory": "packages/annex-iv"
  },
  "bugs": "https://github.com/christiaan839-beep/sovereign-v2/issues",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@sovereign-matrix/verifiable-receipts": ">=0.3.0"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
