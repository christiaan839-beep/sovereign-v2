{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // A local ambient declaration (src/agent-validator.d.ts) tells tsc
    // what @sovereignmatrix/agent-validator looks like so this package
    // type-checks standalone without requiring an npm install of its
    // sibling. The real types are loaded from node_modules once the
    // package is published and consumed.
    "baseUrl": "."
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
