{
  "name": "@sovereign-matrix/hipaa-security",
  "version": "0.1.0",
  "description": "HIPAA Security Rule (45 CFR \u00a7 164.308-318) binder generator. Renders a set of VAOS receipts into the administrative / physical / technical safeguards table (Markdown + JSON), marking each implementation specification evidenced or unevidenced. A receipt is a guardrail verdict on model output, so most specifications are reported as gaps for the operator to evidence elsewhere. Apache-2.0.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "hipaa",
    "hipaa-security-rule",
    "45-cfr-164",
    "administrative-safeguards",
    "physical-safeguards",
    "technical-safeguards",
    "healthcare-compliance",
    "phi",
    "compliance-as-code",
    "vaos",
    "verifiable-receipts",
    "sovereign-matrix"
  ],
  "author": "Sovereign Matrix",
  "license": "Apache-2.0",
  "homepage": "https://github.com/christiaan839-beep/sovereign-v2/tree/main/packages/hipaa-security",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christiaan839-beep/sovereign-v2.git",
    "directory": "packages/hipaa-security"
  },
  "bugs": "https://github.com/christiaan839-beep/sovereign-v2/issues",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@sovereign-matrix/verifiable-receipts": ">=0.3.0"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
