{
  "name": "@sovereign/inspector",
  "version": "0.2.0",
  "description": "Trustless third-party verifier for Sovereign Matrix audit chains, delegation chains, HITL policies, and agentic-commerce ACATs. Verify any deployment's compliance claims locally — no platform trust required.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sovereign-inspect": "./src/cli.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./verify": "./src/verify.mjs",
    "./reputation": "./src/reputation.mjs",
    "./credit": "./src/credit.mjs",
    "./reliability": "./src/reliability.mjs",
    "./audit-export": "./src/audit-export.mjs",
    "./acat": "./src/acat.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sovereign",
    "agent",
    "audit",
    "verify",
    "cryptography",
    "ed25519",
    "trustless",
    "compliance",
    "hash-chain",
    "acat",
    "agentic-commerce",
    "stripe",
    "chargeback-evidence"
  ],
  "homepage": "https://sovereignmatrix.agency",
  "repository": {
    "type": "git",
    "url": "https://github.com/christiaan839-beep/sovereign-v2",
    "directory": "packages/inspector"
  },
  "publishConfig": {
    "access": "public"
  }
}
