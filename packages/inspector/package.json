{
  "name": "@sovereign/inspector",
  "version": "1.0.0",
  "description": "Trustless third-party verifier for Sovereign Matrix. Offline-verify ACATs (R91), edge-node dispatch decisions (R120), perception-mesh plans (R110/R111), benchmark attestations (R130), reliability attestations (R44), agent capability tokens (R37), audit chains (R26), reputation, credit lines, and identity manifests. Zero Sovereign network calls required.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sovereign-inspect": "./src/cli.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./verify": "./src/verify.mjs",
    "./reputation": "./src/reputation.mjs",
    "./credit": "./src/credit.mjs",
    "./reliability": "./src/reliability.mjs",
    "./audit-export": "./src/audit-export.mjs",
    "./acat": "./src/acat.mjs",
    "./perception": "./src/perception.mjs",
    "./edge-nodes": "./src/edge-nodes.mjs",
    "./performance": "./src/performance.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sovereign",
    "agent",
    "audit",
    "verify",
    "cryptography",
    "ed25519",
    "trustless",
    "compliance",
    "hash-chain",
    "acat",
    "agentic-commerce",
    "stripe",
    "chargeback-evidence",
    "perception-mesh",
    "edge-nodes",
    "benchmark-attestation",
    "anti-ai-washing",
    "policy-engine",
    "agent-registry",
    "cost-governance"
  ],
  "homepage": "https://sovereignmatrix.agency",
  "repository": {
    "type": "git",
    "url": "https://github.com/christiaan839-beep/sovereign-v2",
    "directory": "packages/inspector"
  },
  "publishConfig": {
    "access": "public"
  }
}
