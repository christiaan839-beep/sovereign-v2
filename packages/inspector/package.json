    "./audit-export": "./src/audit-export.mjs",
    "./acat": "./src/acat.mjs",
    "./perception": "./src/perception.mjs",
    "./edge-nodes": "./src/edge-nodes.mjs",
    "./performance": "./src/performance.mjs",
    "./governance": "./src/governance.mjs",
    "./memory-guard": "./src/memory-guard.mjs",
    "./aibom": "./src/aibom.mjs",
    "./hitl-routing": "./src/hitl-routing.mjs",
    "./a2a": "./src/a2a.mjs",
    "./mcp": "./src/mcp.mjs",
    "./cross-protocol-bridge": "./src/cross-protocol-bridge.mjs"
