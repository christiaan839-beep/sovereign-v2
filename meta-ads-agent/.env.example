# Meta Ads Manager Agent - secrets. Copy to .env and fill in. Never commit .env.

# Pipeboard MCP token (preferred path for the remote pipeboard-co/meta-ads-mcp server).
# Get one from https://pipeboard.co after connecting your Meta account.
PIPEBOARD_TOKEN=

# Alternative to Pipeboard: a Meta system-user access token with the ads_management scope.
# Only one of PIPEBOARD_TOKEN or META_ACCESS_TOKEN is required for live runs.
META_ACCESS_TOKEN=

# Anthropic key for Phase-3 creative synthesis. If unset, the agent falls back to
# deterministic template copy (clearly marked) so the pipeline still completes in dry-run.
ANTHROPIC_API_KEY=

# Optional model override for creative synthesis (default: claude-sonnet-4-6).
META_AGENT_MODEL=
