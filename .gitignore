# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Next.js App Router lets route paths contain dots — the public
# verification-key endpoint lives under .well-known/sovereign-receipts/
# ed25519.pem/route.ts and is CODE, not a key. Allow source files
# under src/app even if their containing directory matches *.pem.
!src/app/**/.well-known/**
!src/app/**/route.ts
!src/app/**/route.tsx
# Public sample bundle for /pilot — this is the *public* half of a
# throwaway demo keypair (the secret was discarded after generation).
# It's safe to commit; the .pem extension is misleading here.
!public/sample-bundle.ed25519.pem
# Conformance-corpus verification key — public half only, required by
# the TS/Python/Go harnesses on every fresh clone. Regenerate with
# packages/verifiable-receipts/conformance/generate-fixtures.mjs.
!packages/verifiable-receipts/conformance/public-key.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development
.env.production
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# log files
*.log

# IDE
.idea/
.vscode/
.playwright-mcp/

# ── Python ─────────────────────────────────────────────────────────────
# A virtualenv was tracked here: 4,659 files, 92 MB, 70% of the repo by
# file count. That is vendored third-party site-packages inside an
# "All rights reserved" repository whose Agency Licence explicitly permits
# handing the source to a client — i.e. redistributing other people's
# packages with none of their notices. It is also machine-specific: the
# compiled artefacts were built for python3.12 on one laptop.
#
# Recreate it instead:
#   cd server/python-agents && python3 -m venv venv
#   ./venv/bin/pip install -r requirements.txt
venv/
.venv/
__pycache__/
*.py[cod]
