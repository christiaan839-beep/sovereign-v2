{
  "name": "sovereign-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0 <=22.x"
  },
  "bin": {
    "sovereign": "./bin/sovereign.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ws": "ts-node server/ws.ts",
    "test": "vitest run",
    "smoke": "playwright test e2e/smoke.spec.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:migrations:soft": "node scripts/check-migrations.mjs --soft",
    "gen:registry": "node scripts/generate-agent-registry.mjs",
    "check:registry": "node scripts/generate-agent-registry.mjs --check",
    "hooks:install": "git config core.hooksPath scripts/git-hooks && chmod +x scripts/git-hooks/pre-push && echo 'hooks installed: pre-push will run lint + tests + migration check'",
    "hooks:uninstall": "git config --unset core.hooksPath && echo 'hooks uninstalled'",
    "build:packages": "node scripts/build-packages.mjs",
    "postinstall": "node scripts/build-packages.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.103",
    "@ai-sdk/google-vertex": "^4.0.174",
    "@anthropic-ai/sdk": "^0.78.0",
    "@clerk/nextjs": "^7.6.4",
    "@google/generative-ai": "^0.24.1",
    "@google/stitch-sdk": "^0.0.3",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/post-quantum": "^0.6.1",
    "@pinecone-database/pinecone": "^7.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@sentry/nextjs": "^10.69.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tailwindcss/oxide": "^4.3.3",
    "@tavily/core": "^0.7.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.11.2",
    "ai": "^6.0.240",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "groq-sdk": "^1.5.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.577.0",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "resend": "^6.18.1",
    "stripe": "^20.4.1",
    "svix": "^1.99.1",
    "twilio": "^5.13.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "^1.33.0"
  }
}
