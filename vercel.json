{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --force",
  "regions": ["iad1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/job-runner",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/playbook-scheduler",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scheduler",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/health/ping",
      "schedule": "*/4 * * * *"
    },
    {
      "path": "/api/cron/sweep-expired-holds",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/dispatch-scheduled-playbooks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/run-evals",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/rollup-agent-stats",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/slo-weekly",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/verify-audit-chain",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/dag-orphan-cleanup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/drain-usage-outbox",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/prune-hitl-approvals",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/self-heal",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
