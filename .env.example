# ═══════════════════════════════════════════════════════════════
# SOVEREIGN MATRIX — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Variables marked [REQUIRED] must be set for the platform to start.
# Variables marked [OPTIONAL] enable additional features.
# ═══════════════════════════════════════════════════════════════

# ─── Authentication (Clerk) [REQUIRED] ───────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Database (Neon Serverless Postgres) [REQUIRED] ──────────
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ─── AI Providers (at least one required) ────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=           # [REQUIRED] Gemini 2.5 Pro, Imagen, Veo
NVIDIA_NIM_API_KEY=                     # [OPTIONAL] NVIDIA NIM models
ANTHROPIC_API_KEY=                      # [OPTIONAL] Claude models
GROQ_API_KEY=                           # [OPTIONAL] Groq fast inference

# ─── Vector Memory (Pinecone) ────────────────────────────────
PINECONE_API_KEY=                       # [OPTIONAL] Pinecone vector database
PINECONE_INDEX=umbra-memory             # [OPTIONAL] Index name (default: umbra-memory)

# ─── Payments — Stripe ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...           # [OPTIONAL] Stripe payments
STRIPE_WEBHOOK_SECRET=whsec_...         # [OPTIONAL] Stripe webhook verification

# ─── Payments — PayFast (South Africa) ───────────────────────
PAYFAST_MERCHANT_ID=                    # [OPTIONAL]
PAYFAST_MERCHANT_KEY=                   # [OPTIONAL]
PAYFAST_PASSPHRASE=                     # [OPTIONAL]

# ─── Payments — PayStack ─────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=        # [OPTIONAL]

# ─── Communications — Email (Resend) ─────────────────────────
RESEND_API_KEY=                         # [OPTIONAL] Transactional email

# ─── Communications — SMS/WhatsApp (Twilio) ──────────────────
TWILIO_ACCOUNT_SID=                     # [OPTIONAL]
TWILIO_AUTH_TOKEN=                      # [OPTIONAL]
TWILIO_WHATSAPP_NUMBER=                 # [OPTIONAL] e.g. whatsapp:+14155238886

# ─── Communications — Telegram ───────────────────────────────
TELEGRAM_BOT_TOKEN=                     # [OPTIONAL] Telegram bot token
TELEGRAM_ADMIN_CHAT_ID=                 # [OPTIONAL] Admin chat ID for alerts

# ─── Research (Tavily) ───────────────────────────────────────
TAVILY_API_KEY=                         # [OPTIONAL] Web search for agents

# ─── CRM Integrations ────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=                   # [OPTIONAL]
SALESFORCE_CLIENT_ID=                   # [OPTIONAL]
SALESFORCE_CLIENT_SECRET=               # [OPTIONAL]

# ─── Cache (Upstash Redis) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=                 # [OPTIONAL] Persistent rate limiting & cache
UPSTASH_REDIS_REST_TOKEN=              # [OPTIONAL]

# ─── Real-time (Pusher) ──────────────────────────────────────
PUSHER_APP_ID=                          # [OPTIONAL] Real-time WebSocket events
PUSHER_KEY=                             # [OPTIONAL]
PUSHER_SECRET=                          # [OPTIONAL]

# ─── App Configuration ───────────────────────────────────────
NEXT_PUBLIC_URL=http://localhost:3000   # [OPTIONAL] Public URL of the app
CRON_SECRET=                            # [OPTIONAL] Secret for cron job auth

# ─── Lead Enrichment ─────────────────────────────────────────
APOLLO_API_KEY=                         # [OPTIONAL] Apollo.io lead data
