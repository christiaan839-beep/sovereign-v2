# ═══════════════════════════════════════════════════════════════
# SOVEREIGN MATRIX — Environment Variables
# Copy this file to .env.local and fill in your values.
# Variables marked [REQUIRED] must be set for the platform to work.
# Variables marked [OPTIONAL] enable specific features.
# ═══════════════════════════════════════════════════════════════

# ── SECURITY KEYS (Generated — do NOT share) ──────────────────
INTERNAL_SERVICE_SECRET=        # [REQUIRED] Random 64-char hex — secures internal API calls
ENCRYPTION_KEY=                 # [REQUIRED] 64-char hex (32 bytes) — AES-256-GCM for API key encryption
PASSWORD_SALT=                  # [REQUIRED] Random string — HMAC password hashing salt

# ── AUTHENTICATION (Clerk) ────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # [REQUIRED] From clerk.com dashboard
CLERK_SECRET_KEY=                     # [REQUIRED] From clerk.com dashboard

# ── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=                   # [REQUIRED] Neon PostgreSQL connection string

# ── AI MODELS ─────────────────────────────────────────────────
NVIDIA_NIM_API_KEY=             # [REQUIRED] From build.nvidia.com — powers 51+ models
GOOGLE_GENERATIVE_AI_API_KEY=   # [OPTIONAL] Gemini API key (free tier available)
GEMINI_API_KEY=                 # [OPTIONAL] Alternative Gemini key
ANTHROPIC_API_KEY=              # [OPTIONAL] Claude API key (for Claude MCP features)
GROQ_API_KEY=                   # [OPTIONAL] Groq API key (DeepSeek, Qwen, Llama)
TAVILY_API_KEY=                 # [OPTIONAL] Web search for research agents

# ── VECTOR MEMORY (Pinecone) ─────────────────────────────────
PINECONE_API_KEY=               # [OPTIONAL] For agent memory / RAG
PINECONE_INDEX=                 # [OPTIONAL] Pinecone index name
PINECONE_HOST=                  # [OPTIONAL] Pinecone host URL

# ── RATE LIMITING (Upstash Redis) ─────────────────────────────
UPSTASH_REDIS_REST_URL=         # [RECOMMENDED] Persistent rate limits across deploys
UPSTASH_REDIS_REST_TOKEN=       # [RECOMMENDED] Upstash Redis auth token

# ── PAYMENTS ──────────────────────────────────────────────────
# PayFast (Primary — South Africa)
PAYFAST_MERCHANT_ID=            # [OPTIONAL] PayFast merchant ID
PAYFAST_MERCHANT_KEY=           # [OPTIONAL] PayFast merchant key
PAYFAST_PASSPHRASE=             # [OPTIONAL] PayFast passphrase for webhook signatures
PAYFAST_MODE=sandbox            # sandbox or live

# Stripe (International)
STRIPE_SECRET_KEY=              # [OPTIONAL] Stripe secret key
STRIPE_WEBHOOK_SECRET=          # [OPTIONAL] Stripe webhook signing secret
STRIPE_PRICE_NODE=              # [OPTIONAL] Stripe price ID for Node plan
STRIPE_PRICE_ARRAY=             # [OPTIONAL] Stripe price ID for Array plan
STRIPE_PRICE_CARTEL=            # [OPTIONAL] Stripe price ID for Cartel plan

# Paystack (Legacy)
PAYSTACK_SECRET_KEY=            # [OPTIONAL] Paystack secret key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY= # [OPTIONAL] Paystack public key

# Yoco
YOCO_SECRET_KEY=                # [OPTIONAL] Yoco secret key

# ── EMAIL (Resend) ────────────────────────────────────────────
RESEND_API_KEY=                 # [OPTIONAL] Resend API key for transactional emails
RESEND_FROM=Sovereign Matrix <noreply@sovereignmatrix.agency>

# ── VOICE & MESSAGING ────────────────────────────────────────
TWILIO_ACCOUNT_SID=             # [OPTIONAL] Twilio for voice calls + WhatsApp
TWILIO_AUTH_TOKEN=              # [OPTIONAL] Twilio auth token
TWILIO_WHATSAPP_NUMBER=         # [OPTIONAL] Twilio WhatsApp number
ELEVENLABS_API_KEY=             # [OPTIONAL] ElevenLabs for text-to-speech

# ── TELEGRAM BOT ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=             # [OPTIONAL] Telegram bot token
TELEGRAM_WEBHOOK_SECRET=        # [OPTIONAL] Telegram webhook verification secret
TELEGRAM_COMMANDER_CHAT_ID=     # [OPTIONAL] Admin chat ID for commands
TELEGRAM_ADMIN_CHAT_ID=         # [OPTIONAL] Admin notification chat

# ── WEBHOOKS ──────────────────────────────────────────────────
CRM_WEBHOOK_SECRET=             # [OPTIONAL] HubSpot/Salesforce webhook HMAC secret
CALCOM_WEBHOOK_SECRET=          # [OPTIONAL] Cal.com booking webhook secret
CALCOM_BOOKING_URL=             # [OPTIONAL] Cal.com booking link
CRON_SECRET=                    # [OPTIONAL] Secret for cron job endpoints

# ── NEMOCLAW (Local Agent Execution) ─────────────────────────
NEXT_PUBLIC_NEMOCLAW_TOKEN=     # [OPTIONAL] NemoClaw local daemon auth token
NEMOCLAW_URL=http://127.0.0.1:18789  # NemoClaw daemon URL
LOCAL_OLLAMA_URL=http://localhost:11434  # Ollama for local model inference

# ── INTEGRATIONS ──────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=           # [OPTIONAL] HubSpot CRM integration
SALESFORCE_CLIENT_ID=           # [OPTIONAL] Salesforce OAuth
SALESFORCE_CLIENT_SECRET=       # [OPTIONAL] Salesforce OAuth
FIRECRAWL_API_KEY=              # [OPTIONAL] Firecrawl web scraping
N8N_WEBHOOK_URL=                # [OPTIONAL] n8n workflow automation
META_ACCESS_TOKEN=              # [OPTIONAL] Meta/Facebook ads
META_AD_ACCOUNT_ID=             # [OPTIONAL] Meta ad account

# ── DEPLOYMENT ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://sovereignmatrix.agency
VERCEL_ACCESS_TOKEN=            # [OPTIONAL] For white-label provisioning
PUSHER_APP_ID=                  # [OPTIONAL] Real-time updates
PUSHER_KEY=                     # [OPTIONAL] Pusher key
PUSHER_SECRET=                  # [OPTIONAL] Pusher secret
