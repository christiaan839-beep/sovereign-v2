# ============================================
# SOVEREIGN MATRIX — Environment Variables
# ============================================
# Copy to .env.local and fill in your keys.
#
# REQUIRED to start: GOOGLE_GENERATIVE_AI_API_KEY (or NVIDIA_NIM_API_KEY)
#                  + DATABASE_URL + Clerk keys
# All others enable additional features and degrade gracefully if absent.
#
# Legend:
#   [REQUIRED]  — Platform won't function without this
#   [IMPORTANT] — Core feature is disabled without this
#   [OPTIONAL]  — Enables a specific integration, platform works fine without it
#
# Trimmed in audit-2026-05: removed 12 vestigial entries (Pinecone,
# Stitch, Supabase, Kokoro, NemoClaw, vLLM, generic webhook auth)
# that had no production callers. See docs/audits/codebase-audit.md.

# ─── AI Models ───────────────────────────────────────────────────────────────
# At least one AI provider is required. NVIDIA NIM is recommended (65+ free models).
GOOGLE_GENERATIVE_AI_API_KEY=   # [REQUIRED]  Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=                 # [OPTIONAL]  Alias for above (either works)
NVIDIA_NIM_API_KEY=             # [IMPORTANT] NVIDIA NIM → https://build.nvidia.com (FREE — 65+ models)
NVIDIA_API_KEY=                 # [OPTIONAL]  Alias for NVIDIA_NIM_API_KEY
ANTHROPIC_API_KEY=              # [OPTIONAL]  Anthropic → https://console.anthropic.com/settings/keys
GROQ_API_KEY=                   # [OPTIONAL]  Groq → https://console.groq.com/keys (FREE — ultra-fast)
CEREBRAS_API_KEY=               # [IMPORTANT] Cerebras → https://inference.cerebras.ai (FREE — 2000+ tok/s)
LOCAL_OLLAMA_URL=               # [OPTIONAL]  Ollama → http://localhost:11434 (FREE — local models)

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=                   # [REQUIRED]  Neon PostgreSQL → https://neon.tech

# ─── Authentication ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # [REQUIRED] Clerk → https://dashboard.clerk.com
CLERK_SECRET_KEY=                   # [REQUIRED] Clerk → https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=           # [IMPORTANT] Clerk Dashboard → Webhooks → Signing secret. Required for /api/webhooks/clerk to verify user.created/deleted events.

# ─── Distributed Rate Limiting ───────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=         # [IMPORTANT] Upstash → https://upstash.com → Create Database → REST URL
UPSTASH_REDIS_REST_TOKEN=       # [IMPORTANT] Same page → REST Token

# ─── Live Web Research ───────────────────────────────────────────────────────
TAVILY_API_KEY=                 # [IMPORTANT] Tavily → https://app.tavily.com/home
FIRECRAWL_API_KEY=              # [OPTIONAL]  Firecrawl → https://www.firecrawl.dev

# ─── Payments: Stripe (Global) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=              # [IMPORTANT] Stripe → https://dashboard.stripe.com/apikeys
STRIPE_WEBHOOK_SECRET=          # [IMPORTANT] Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_PRICE_STARTER=           # [OPTIONAL]  Stripe Price ID for Starter plan ($19/mo)
STRIPE_PRICE_ARRAY=             # [OPTIONAL]  Stripe Price ID for Growth plan ($49/mo)
STRIPE_PRICE_NODE=              # [OPTIONAL]  Stripe Price ID for Node plan
STRIPE_PRICE_ENTERPRISE=        # [OPTIONAL]  Stripe Price ID for Enterprise plan

# ─── Payments: PayFast (South Africa) ────────────────────────────────────────
PAYFAST_MERCHANT_ID=            # [OPTIONAL]  PayFast → https://www.payfast.co.za
PAYFAST_MERCHANT_KEY=           # [OPTIONAL]  PayFast Dashboard → Settings
PAYFAST_PASSPHRASE=             # [OPTIONAL]  PayFast Dashboard → Security
PAYFAST_MODE=sandbox            # [OPTIONAL]  "live" for production

# ─── Payments: PayStack (Africa) ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=            # [OPTIONAL]  PayStack → https://dashboard.paystack.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY= # [OPTIONAL] PayStack public key (for client-side)

# ─── Payments: Yoco (South Africa) ───────────────────────────────────────────
YOCO_SECRET_KEY=                # [OPTIONAL]  Yoco → https://developer.yoco.com
YOCO_WEBHOOK_SECRET=            # [OPTIONAL]  Yoco → Webhooks → signing secret (HMAC-SHA256 verification)

# ─── Payments: Crypto via Coinbase Commerce (BTC/ETH/USDC/DAI/LTC/DOGE) ─────
# Hybrid: buyer pays in decentralized assets, settlement is processed by
# Coinbase. For fully-decentralized (self-custody) settlement, see
# docs/crypto-payments.md — that path is documented, not wired by default.
COINBASE_COMMERCE_API_KEY=       # [OPTIONAL]  https://beta.commerce.coinbase.com → Settings → API keys
COINBASE_COMMERCE_WEBHOOK_SECRET= # [OPTIONAL] Commerce → Settings → Notifications → Shared Secret (HMAC-SHA256)

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=                 # [IMPORTANT] Resend → https://resend.com/api-keys
RESEND_FROM=noreply@sovereignmatrix.agency  # [OPTIONAL] Sender email address
RESEND_FROM_EMAIL=              # [OPTIONAL]  Alias for RESEND_FROM
EMAIL_FROM=                     # [OPTIONAL]  Final fallback sender used by src/lib/email-service.ts when RESEND_FROM/RESEND_FROM_EMAIL are unset.
EMAIL_ACCOUNT_CREATED_AT=       # [OPTIONAL]  ISO timestamp marking when the sending account was created. Used by src/lib/email-service.ts to gate cold-send rate-limiting until the account is warm. Defaults to "now" if absent.
GMAIL_USER=                     # [OPTIONAL]  Gmail fallback (app password)
GMAIL_APP_PASSWORD=             # [OPTIONAL]  Gmail app password

# ─── Communications: Twilio (WhatsApp + SMS) ─────────────────────────────────
TWILIO_ACCOUNT_SID=             # [OPTIONAL]  Twilio → https://console.twilio.com
TWILIO_AUTH_TOKEN=              # [OPTIONAL]  Twilio Console
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886  # [OPTIONAL] Twilio WhatsApp sandbox number
TWILIO_PHONE_NUMBER=            # [OPTIONAL]  Twilio phone number for SMS/Voice

# ─── Communications: Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=             # [OPTIONAL]  BotFather → https://t.me/BotFather
TELEGRAM_ADMIN_CHAT_ID=         # [OPTIONAL]  Your chat ID → message @userinfobot on Telegram
TELEGRAM_CHAT_ID=               # [OPTIONAL]  Alias for TELEGRAM_ADMIN_CHAT_ID
TELEGRAM_COMMANDER_CHAT_ID=     # [OPTIONAL]  Sovereign Commander channel chat ID
TELEGRAM_WEBHOOK_SECRET=        # [OPTIONAL]  Random string for webhook verification

# ─── Voice / Media ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=             # [OPTIONAL]  ElevenLabs → https://elevenlabs.io
VIDEO_GEN_API_KEY=              # [OPTIONAL]  Video generation service API key

# ─── CRM Integrations ────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=           # [OPTIONAL]  HubSpot → https://developers.hubspot.com
HUBSPOT_CLIENT_SECRET=          # [OPTIONAL]  HubSpot Developer App → Auth → Client secret. Required for /api/_webhooks/crm to verify v3 signatures.
SALESFORCE_CLIENT_ID=           # [OPTIONAL]  Salesforce connected app
SALESFORCE_CLIENT_SECRET=       # [OPTIONAL]  Salesforce connected app
AIRTABLE_API_KEY=               # [OPTIONAL]  Airtable → https://airtable.com/account
NOTION_API_KEY=                 # [OPTIONAL]  Notion → https://www.notion.so/my-integrations

# ─── Social Integrations ─────────────────────────────────────────────────────
META_ACCESS_TOKEN=              # [OPTIONAL]  Meta Business → https://business.facebook.com
META_AD_ACCOUNT_ID=             # [OPTIONAL]  Meta Ads account ID
X_API_KEY=                      # [OPTIONAL]  X/Twitter API key → https://developer.x.com
SLACK_WEBHOOK_URL=              # [OPTIONAL]  Slack → Apps → Incoming Webhooks

# ─── Workflows ───────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=                # [OPTIONAL]  n8n → https://n8n.io
CALCOM_BOOKING_URL=             # [OPTIONAL]  Cal.com booking URL
CALCOM_WEBHOOK_SECRET=          # [OPTIONAL]  Cal.com → Webhooks → Signing secret (HMAC verification for booking events)

# ─── Deployment ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=            # [IMPORTANT] Your live URL (e.g., https://sovereignmatrix.agency)
NEXT_PUBLIC_URL=                # [OPTIONAL]  Alias for NEXT_PUBLIC_APP_URL
NEXTAUTH_URL=                   # [OPTIONAL]  Legacy NextAuth env name. Used as a fallback for absolute-URL construction in src/lib/a2e.ts when NEXT_PUBLIC_APP_URL/VERCEL_URL are absent. Set this only if you can't set NEXT_PUBLIC_APP_URL.
CRON_SECRET=                    # [IMPORTANT] Random string to secure cron endpoints
ENCRYPTION_KEY=                 # [IMPORTANT] Random string for data encryption (min 32 chars)
AGENT_RUN_SIGNING_SECRET=       # [IMPORTANT] HMAC-SHA256 key for verifiable agent receipts (min 16 chars). Without it /api/verify returns valid:false for every receipt and the embed badge shows "Unverified". Falls back to CRON_SECRET if absent.
WS_PORT=8080                    # [OPTIONAL]  WebSocket server port (server/ws.ts). Default 8080.

# Vercel built-ins (NEXT_RUNTIME, NODE_ENV, VERCEL, VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL) are auto-injected by Vercel — do not set them.

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_USER_IDS=                 # [IMPORTANT] Comma-separated Clerk user IDs allowed to grant bonus/referral credits and call /api/_admin/* routes
SYSTEM_USER_ID=                 # [OPTIONAL]  Clerk user ID used for system-initiated runs (cron, webhook fan-out). Empty = those runs skip user-scoped persistence.
DATA_SOVEREIGNTY_MODE=          # [OPTIONAL]  Set to "strict" to force EU-region inference and PII redaction before any non-local model call. Empty = standard mode.

# ─── Error Tracking ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=         # [IMPORTANT] Sentry → https://sentry.io (client-side error tracking)
SENTRY_DSN=                     # [IMPORTANT] Sentry → same DSN (server-side)
SENTRY_AUTH_TOKEN=              # [OPTIONAL]  Sentry auth token (for source maps upload)

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=   # [OPTIONAL]  Plausible → https://plausible.io

# ─── Google Cloud (optional) ─────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY=     # [OPTIONAL]  GCP service account JSON (base64 encoded)

# ─── Vercel platform (optional) ──────────────────────────────────────────────
VERCEL_ACCESS_TOKEN=            # [OPTIONAL]  Vercel API token. Required only if you use the provisioning agent at /api/_misc/provisioning to create projects from the dashboard.
VERCEL_AI_GATEWAY_KEY=          # [OPTIONAL]  Vercel AI Gateway routing token. The /api/_agents/ai-gateway route uses this when set; falls back to NVIDIA NIM otherwise.

# ─── Distribution: Slack bot (Cook 63 + 67) ──────────────────────────────────
SLACK_SIGNING_SECRET=           # [OPTIONAL]  Slack app → Basic Information → Signing Secret. Required for /api/_webhooks/slack to verify v0 HMAC.

# ─── Distribution: GitHub App (Cook 64 + 68) ─────────────────────────────────
GITHUB_WEBHOOK_SECRET=          # [OPTIONAL]  GitHub App → Webhook secret. Required for /api/_webhooks/github HMAC-SHA256 verification.

# ─── Code sandbox (Cook 54 + 78) ─────────────────────────────────────────────
E2B_API_KEY=                    # [OPTIONAL]  e2b.dev API key for the Tier-3 `run_code` tool. Without it the sandbox tool returns a "not configured" outcome.

# ─── Browser automation (Cook 61 + 79) ───────────────────────────────────────
BROWSERBASE_API_KEY=            # [OPTIONAL]  Browserbase API key for the Tier-3 `browser_session` tool. Without it browser-automation returns "not configured".
BROWSERBASE_PROJECT_ID=         # [OPTIONAL]  Browserbase project id (passed to /v1/sessions).

# ─── Voice loop (Cook 60 + 74) ───────────────────────────────────────────────
# GROQ_API_KEY is reused for ASR (Whisper-Large-V3 via Groq).
ELEVENLABS_VOICE_ID=            # [OPTIONAL]  ElevenLabs voice id for TTS replies. Defaults to a generic preset if unset.
