{
  "manifest_version": 3,
  "name": "Sovereign Matrix",
  "version": "1.0.0",
  "description": "Analyze any website with 132 AI agents. Right-click to audit SEO, find leads, analyze competitors.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["https://sovereignmatrix.agency/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
